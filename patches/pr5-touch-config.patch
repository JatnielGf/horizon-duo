+            ("pause", layout.button(Button::Pause)),
+            ("back", layout.button(Button::Back)),
+            ("shift", layout.button(Button::Shift)),
+            ("chat", layout.button(Button::Chat)),
+        ];
+        rects.extend(
+            CONTROLS
+                .iter()
