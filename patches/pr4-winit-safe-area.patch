From c88e29b870055904880b59c6ab95d2186397dd0f Mon Sep 17 00:00:00 2001
From: Jatniel <noreply@example.com>
Date: Sat, 7 Nov 2026 17:20:13 +0000
Subject: [PATCH] winit iOS: expose the view's safe area insets

WindowExtIOS::safe_area_insets returns safeAreaInsets of the window's view in
physical pixels (notch, rounded corners, status bar, home indicator), so the
game can keep touch controls clear of them. Nothing uses it yet.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 third_party/winit/src/platform/ios.rs         | 23 +++++++++++++++++++
 .../winit/src/platform_impl/ios/window.rs     | 13 +++++++++++
 2 files changed, 36 insertions(+)

diff --git a/third_party/winit/src/platform/ios.rs b/third_party/winit/src/platform/ios.rs
index 6e62876..48049ce 100644
--- a/third_party/winit/src/platform/ios.rs
+++ b/third_party/winit/src/platform/ios.rs
@@ -128,6 +128,14 @@ pub trait WindowExtIOS {
     /// This only has an effect on iOS 11.0+.
     fn set_prefers_home_indicator_hidden(&self, hidden: bool);
 
+    /// The parts of the [`Window`] that the notch, the rounded corners, the status bar or the
+    /// home indicator can cover, in physical pixels from each edge of the view.
+    ///
+    /// This is [`-[UIView safeAreaInsets]`](https://developer.apple.com/documentation/uikit/uiview/2891103-safeareainsets?language=objc)
+    /// of the window's view, rounded up to whole pixels. It changes when the device rotates, so
+    /// ask again after a `Resized`.
+    fn safe_area_insets(&self) -> SafeAreaInsets;
+
     /// Sets the screen edges for which the system gestures will take a lower priority than the
     /// application's touch handling.
     ///
@@ -194,6 +202,16 @@ pub trait WindowExtIOS {
     fn recognize_rotation_gesture(&self, should_recognize: bool);
 }
 
+/// How far the notch, the rounded corners and the system bars reach into the window, in
+/// physical pixels from each edge.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct SafeAreaInsets {
+    pub top: u32,
+    pub left: u32,
+    pub bottom: u32,
+    pub right: u32,
+}
+
 impl WindowExtIOS for Window {
     #[inline]
     fn set_scale_factor(&self, scale_factor: f64) {
@@ -210,6 +228,11 @@ impl WindowExtIOS for Window {
         self.window.maybe_queue_on_main(move |w| w.set_prefers_home_indicator_hidden(hidden))
     }
 
+    #[inline]
+    fn safe_area_insets(&self) -> SafeAreaInsets {
+        self.window.maybe_wait_on_main(|w| w.safe_area_insets())
+    }
+
     #[inline]
     fn set_preferred_screen_edges_deferring_system_gestures(&self, edges: ScreenEdge) {
         self.window.maybe_queue_on_main(move |w| {
diff --git a/third_party/winit/src/platform_impl/ios/window.rs b/third_party/winit/src/platform_impl/ios/window.rs
index 0889897..48d2202 100644
--- a/third_party/winit/src/platform_impl/ios/window.rs
+++ b/third_party/winit/src/platform_impl/ios/window.rs
@@ -193,6 +193,19 @@ impl Inner {
         size.to_physical(scale_factor)
     }
 
+    /// `safeAreaInsets` of the view, in physical pixels (zero where nothing covers it).
+    pub fn safe_area_insets(&self) -> crate::platform::ios::SafeAreaInsets {
+        let scale = self.scale_factor();
+        let insets = self.view.safeAreaInsets();
+        let pixels = |points: f64| (points.max(0.0) * scale).ceil() as u32;
+        crate::platform::ios::SafeAreaInsets {
+            top: pixels(insets.top as f64),
+            left: pixels(insets.left as f64),
+            bottom: pixels(insets.bottom as f64),
+            right: pixels(insets.right as f64),
+        }
+    }
+
     pub fn outer_size(&self) -> PhysicalSize<u32> {
         let scale_factor = self.scale_factor();
         let screen_frame = self.screen_frame();
