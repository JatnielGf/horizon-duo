+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(&dir).unwrap();
+        dir
+    }
+
+    fn enabled(screen: &Screen, id: u8) -> bool {
+        screen
+            .buttons(800.0, 600.0)
+            .iter()
+            .find(|b| b.5 == id)
+            .is_some_and(|b| b.4)
+    }
+
+    fn type_name(screen: &mut Screen, text: &str) {
+        screen.type_text(text);
+    }
+
