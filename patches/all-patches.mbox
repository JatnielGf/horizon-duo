 pub mod profile;
+pub mod profile_screen;
 pub mod projectiles;
 pub mod raid;
 pub mod random_sequences;
diff --git a/crates/horizon-client/src/profile_screen.rs b/crates/horizon-client/src/profile_screen.rs
