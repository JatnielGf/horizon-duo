diff --git a/crates/horizon-client/src/title/tests.rs b/crates/horizon-client/src/title/tests.rs
index 357ab8a..023e95f 100644
--- a/crates/horizon-client/src/title/tests.rs
+++ b/crates/horizon-client/src/title/tests.rs
@@ -890,3 +890,36 @@ fn a_typed_field_name_focuses_its_box_and_a_wrong_one_changes_nothing() {
     f.title.focus_field("name").unwrap();
     assert!(matches!(f.title.mode, Mode::Edit { focused: true, .. }));
