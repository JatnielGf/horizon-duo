+    #[test]
+    fn opacity_scales_the_alpha_and_keeps_the_color() {
+        assert_eq!(fade(OUTLINE, 1.0), OUTLINE);
+        assert_eq!(fade(0xdcff_ffff, 0.5), 0x6eff_ffff);
+        assert_eq!(fade(0xdcab_cdef, 0.0), 0x00ab_cdef);
+        assert_eq!(fade(u32::MAX, 0.25) >> 24, 64);
