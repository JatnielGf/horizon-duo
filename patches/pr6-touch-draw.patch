+/// `color` with its alpha (the top byte) multiplied by `opacity`, from 0 to 1.
+fn fade(color: u32, opacity: f32) -> u32 {
+    if opacity >= 1.0 {
+        return color;
+    }
+    let alpha = ((color >> 24) as f32 * opacity.max(0.0)).round() as u32;
+    (color & 0x00ff_ffff) | alpha << 24
+}
